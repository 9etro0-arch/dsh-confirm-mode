{
  "name": "dsh-confirm-mode",
  "version": "0.1.0",
  "description": "An independent confirm mode for DeepSeek Harness: every sensitive-permission invocation asks the user to confirm, one call at a time, instead of being auto-approved. DSH 确认模式插件。",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "approval",
    "permissions",
    "confirm",
    "确认模式"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.1.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "scripts": {
    "check": "node --check index.js && node --check lib/client.js"
  }
}
